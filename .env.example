# Archive-capable Robinhood Chain mainnet RPC. Keep the real value in .env only.
EVM_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_YOUR_API_KEY
EVM_CHAIN_ID=4663

# Required only for the explicit Robinhood fork-validation gate. Do not use `latest`.
RUN_ROBINHOOD_FORK=0
ROBINHOOD_FORK_BLOCK=REPLACE_WITH_FIXED_CHILD_CHAIN_BLOCK
ROBINHOOD_FORK_BLOCK_HASH=0xREPLACE_WITH_64_HEX_CHARACTERS
ROBINHOOD_WETH=0xREPLACE_WITH_WETH_ADDRESS
ROBINHOOD_SNAPSHOT_APPROVER=0xREPLACE_WITH_MULTISIG_OR_TIMELOCK

# Required for deployment preflight; these must be contract addresses, never EOAs.
FACTORY_OWNER=0xREPLACE_WITH_DEPLOYED_SAFE_OR_TIMELOCK
ELIGIBILITY_TOKEN=0xREPLACE_WITH_REVIEWED_IMMUTABLE_ERC20
SNAPSHOT_APPROVER=0xREPLACE_WITH_DEPLOYED_SAFE_OR_TIMELOCK
